#!/usr/bin/env bash
# Runs the Swift SDK's tests on an iOS simulator: the UIKit half (the lifecycle
# notices, the send on leaving the foreground) that `swift test` on the Mac
# never compiles. Uses the XCFramework scripts/build-xcframework.sh built, and a
# simulator of its own, "ClickMan Tests", created on the newest iOS runtime.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
NAME="ClickMan Tests"

udid="$(xcrun simctl list devices available -j | NAME="$NAME" /usr/bin/python3 -c '
import json, os, sys
for devices in json.load(sys.stdin)["devices"].values():
    for device in devices:
        if device["name"] == os.environ["NAME"]:
            print(device["udid"])
            raise SystemExit
')"

if [ -z "$udid" ]; then
  read -r runtime devicetype < <(xcrun simctl list runtimes available -j | /usr/bin/python3 -c '
import json, sys
ios = [runtime for runtime in json.load(sys.stdin)["runtimes"] if runtime["platform"] == "iOS"]
newest = max(ios, key=lambda runtime: [int(part) for part in runtime["version"].split(".")])
iphone = next(kind for kind in newest["supportedDeviceTypes"] if kind["productFamily"] == "iPhone")
print(newest["identifier"], iphone["identifier"])
')
  udid="$(xcrun simctl create "$NAME" "$devicetype" "$runtime")"
fi

cd "$ROOT"
xcodebuild test -scheme ClickMan-Package -destination "platform=iOS Simulator,id=$udid" \
  -only-testing:ClickManTests -collect-test-diagnostics never \
  -test-timeouts-enabled YES -default-test-execution-time-allowance 60
