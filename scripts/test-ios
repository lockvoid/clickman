#!/usr/bin/env bash
# Runs the Swift client's tests on an iOS simulator: the UIKit half (the lifecycle
# notices, the send on leaving the foreground) that `swift test` on the Mac never
# compiles. Uses a simulator of its own, "ClickMan Tests", on the newest iOS runtime.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
NAME="ClickMan Tests"

udid="$(xcrun simctl list devices available -j | NAME="$NAME" ruby -rjson -e '
  device = JSON.parse($stdin.read)["devices"].values.flatten.find { it["name"] == ENV["NAME"] }
  puts device["udid"] if device
')"

if [ -z "$udid" ]; then
  read -r runtime devicetype < <(xcrun simctl list runtimes available -j | ruby -rjson -e '
    ios = JSON.parse($stdin.read)["runtimes"].select { it["platform"] == "iOS" }
    newest = ios.max_by { it["version"].split(".").map(&:to_i) }
    iphone = newest["supportedDeviceTypes"].find { it["productFamily"] == "iPhone" }
    puts "#{newest["identifier"]} #{iphone["identifier"]}"
  ')
  udid="$(xcrun simctl create "$NAME" "$devicetype" "$runtime")"
fi

cd "$ROOT"
xcodebuild test -scheme ClickMan-Package -destination "platform=iOS Simulator,id=$udid" \
  -only-testing:ClickManTests -collect-test-diagnostics never \
  -test-timeouts-enabled YES -default-test-execution-time-allowance 60
