<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title><%= content_for?(:title) ? "#{content_for(:title)} · Analytics" : 'Analytics' %></title>
    <style nonce="<%= content_security_policy_nonce %>">
      :root {
        color-scheme: light dark;
        --ink: #1d1d1f;
        --muted: #6e6e73;
        --line: #e5e5ea;
        --panel: #f5f5f7;
        --accent: #e5484d;
        --page: #ffffff;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --ink: #f5f5f7;
          --muted: #98989d;
          --line: #2c2c2e;
          --panel: #1c1c1e;
          --page: #000000;
        }
      }

      * { box-sizing: border-box; }
      body { margin: 0; background: var(--page); color: var(--ink); font: 15px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
      main { max-width: 960px; margin: 0 auto; padding: 32px 20px 64px; }
      h1 { margin: 0 0 24px; font-size: 28px; }
      h2 { margin: 40px 0 12px; font-size: 17px; }
      a { color: var(--accent); text-decoration: none; }
      code { font-size: 13px; }
      .back { display: inline-block; margin-bottom: 8px; color: var(--muted); }
      .empty, .computed, .summary { color: var(--muted); }
      .computed { font-size: 13px; }
      .metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
      .metric { padding: 16px; border-radius: 12px; background: var(--panel); }
      .metric .label { display: block; color: var(--muted); font-size: 13px; }
      .metric .value { display: block; font-size: 32px; font-weight: 600; font-variant-numeric: tabular-nums; }
      .bars { display: block; width: 100%; height: 64px; margin-top: 16px; fill: var(--accent); }
      table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
      th, td { padding: 8px 12px 8px 0; border-bottom: 1px solid var(--line); text-align: left; }
      th { color: var(--muted); font-size: 13px; font-weight: 500; }
      .number { text-align: right; }
      .funnels { margin: 0; padding: 0; list-style: none; }
      .funnels li { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
      .steps { margin: 0; padding: 0; list-style: none; }
      .step { display: grid; grid-template-columns: 1fr auto 4em; gap: 6px 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
      .step [data-actors], .step [data-conversion] { font-weight: 600; font-variant-numeric: tabular-nums; text-align: right; }
      .step .share { grid-column: 1 / -1; width: 100%; height: 6px; }
      .step .track { fill: var(--panel); }
      .step .fill { fill: var(--accent); }
      .step .median { grid-column: 1 / -1; color: var(--muted); font-size: 13px; }
      @media (max-width: 600px) { .metrics { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body>
    <main>
      <%= yield %>
    </main>
  </body>
</html>
